+          <Badge className="bg-[#102b36] text-[#00ff88]">{learners.length} assigned</Badge>
+        </CardHeader>
+        <CardContent>
+          {learnersQuery.isLoading ? (
+            <div className="h-24 animate-pulse rounded-xl bg-[#18093c]" />
