+// Links an enrolled/subscribed learner to the instructor who supervises them.
+// A learner has at most one active row at a time; reassigning ends the previous
+// row so the full supervision history is preserved for auditing.
+export const supervisions = mysqlTable("supervisions", {
+  id: int("id").autoincrement().primaryKey(),
+  studentId: int("studentId").notNull(),
+  instructorId: int("instructorId").notNull(),
+  status: mysqlEnum("status", ["active", "ended"]).default("active").notNull(),
+  notes: text("notes"),
+  assignedBy: int("assignedBy"),
+  createdAt: timestamp("createdAt").defaultNow().notNull(),
+  updatedAt: timestamp("updatedAt").defaultNow().onUpdateNow().notNull(),
+  endedAt: timestamp("endedAt"),
+});
+
