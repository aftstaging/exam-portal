# ============================================================
# Required
# ============================================================
# MySQL connection string for the production database
# (create a dedicated user, never root)
DATABASE_URL=mysql://aftportal:CHANGE_ME_DB_PASSWORD@localhost:3306/aft_portal

# JWT signing secret for session cookies — generate a long random value
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48

# The owner admin account. When someone registers with this email they
# automatically become admin. Also used for "Notify owner"
OWNER_EMAIL=admin@accountantsfortomorrow.co.za
OWNER_NAME=Accountants for Tomorrow
# Legacy OAuth backfill — keep as is or empty; local sign-in does not use it
OWNER_OPEN_ID=

# ============================================================
# AWS S3 (file uploads: printable PDFs, admin resources, objective attachments)
# Either set keys here OR give the EC2 instance an IAM role with S3 Put/Get
# ============================================================
AWS_REGION=eu-west-1
S3_BUCKET=aft-learning-portal-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible endpoint (MinIO/localstack); remove for real AWS
S3_ENDPOINT=

# ============================================================
# Payments — PayFast (used by the storefront cart checkout)
# ============================================================
PAYFAST_MODE=sandbox
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=
PAYFAST_LIVE_MERCHANT_ID=
PAYFAST_LIVE_MERCHANT_KEY=
PAYFAST_LIVE_PASSPHRASE=

# ============================================================
# Payments — Stripe (optional; webhook-only integration)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# Runtime (optional)
# ============================================================
NODE_ENV=production
PORT=3000

# ============================================================
# Public URL path prefix
# ------------------------------------------------------------
# Where the portal is mounted on the host. The exam portal is served at
# http://<host>/exam, so this is /exam. It is read in three places and must be
# set identically for all of them:
#   * the Vite build, which prefixes built asset URLs (import.meta.env.BASE_URL)
#   * the Express app, which mounts every route under the prefix
#   * the browser bundle, which strips the prefix before matching routes
# Leave blank (or "/") to serve from the domain root, which is what local
# development uses.
# ============================================================
APP_BASE_PATH=/exam

# ============================================================
# QA / demo learner access (TEMPORARY, keep OFF in production)
# ------------------------------------------------------------
# When set to true, the public auth.qaDemoLogin procedure can start a
# session for the isolated demo learner (provisioned by an admin via
# admin.provisionDemoLearner). The demo account is always a non-admin
# user: it cannot access admin endpoints, cannot grant/alter real
# learner entitlements, and does not affect PayFast verification or
# protected-resource safeguards. Leave blank/false to disable.
# AFT_QA_DEMO_ACCESS=true