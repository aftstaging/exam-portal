# ============================================================
# Required
# ============================================================
# MySQL connection string for the production database
# (create a dedicated user, never root)
DATABASE_URL=mysql://aftportal:CHANGE_ME_DB_PASSWORD@localhost:3306/aft_portal

# JWT signing secret for session cookies — generate a long random value
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48

# The owner admin account. When someone registers with this email they
# automatically become admin. Also used for "Notify owner"
OWNER_EMAIL=admin@accountantsfortomorrow.co.za
OWNER_NAME=Accountants for Tomorrow
# Legacy OAuth backfill — keep as is or empty; local sign-in does not use it
OWNER_OPEN_ID=

# ============================================================
# AWS S3 (file uploads: printable PDFs, admin resources, objective attachments)
# Either set keys here OR give the EC2 instance an IAM role with S3 Put/Get
# ============================================================
AWS_REGION=eu-west-1
S3_BUCKET=aft-learning-portal-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible endpoint (MinIO/localstack); remove for real AWS
S3_ENDPOINT=

# ============================================================
# Payments — PayFast (used by the storefront cart checkout)
# ============================================================
PAYFAST_MODE=sandbox
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=
PAYFAST_LIVE_MERCHANT_ID=
PAYFAST_LIVE_MERCHANT_KEY=
PAYFAST_LIVE_PASSPHRASE=

# ============================================================
# Payments — Stripe (optional; webhook-only integration)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# Runtime (optional)
# ============================================================
NODE_ENV=production
PORT=3000